{
  "$ref": "#/definitions/ExtractionOutput",
  "definitions": {
    "ExtractionOutput": {
      "type": "object",
      "properties": {
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "localId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "kind": {
                "type": "string",
                "enum": [
                  "decision",
                  "proposal",
                  "task",
                  "blocker",
                  "risk",
                  "dependency",
                  "responsibility",
                  "contact",
                  "open_question"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "workState": {
                "type": "string",
                "enum": [
                  "proposed",
                  "open",
                  "in_progress",
                  "blocked",
                  "completed",
                  "cancelled",
                  "superseded",
                  "unknown"
                ]
              },
              "ownerLabel": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "observedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidenceState": {
                "type": "string",
                "enum": [
                  "supported",
                  "corroborated",
                  "needs_confirmation",
                  "conflicting",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "chunkId": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 2000
                    }
                  },
                  "required": [
                    "chunkId",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                "minItems": 1,
                "maxItems": 10
              }
            },
            "required": [
              "localId",
              "kind",
              "statement",
              "workState",
              "ownerLabel",
              "observedAt",
              "evidenceState",
              "evidence"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        }
      },
      "required": [
        "claims"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
