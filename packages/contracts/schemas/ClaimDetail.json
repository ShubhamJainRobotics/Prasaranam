{
  "$ref": "#/definitions/ClaimDetail",
  "definitions": {
    "ClaimDetail": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "projectId": {
          "$ref": "#/definitions/ClaimDetail/properties/id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "decision",
            "proposal",
            "task",
            "blocker",
            "risk",
            "dependency",
            "responsibility",
            "contact",
            "open_question"
          ]
        },
        "statement": {
          "type": "string"
        },
        "workState": {
          "type": "string",
          "enum": [
            "proposed",
            "open",
            "in_progress",
            "blocked",
            "completed",
            "cancelled",
            "superseded",
            "unknown"
          ]
        },
        "evidenceState": {
          "type": "string",
          "enum": [
            "supported",
            "corroborated",
            "needs_confirmation",
            "conflicting",
            "unknown"
          ]
        },
        "reviewState": {
          "type": "string",
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "ownerUserId": {
          "anyOf": [
            {
              "$ref": "#/definitions/ClaimDetail/properties/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "ownerLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "ownerDisplayName": {
          "type": [
            "string",
            "null"
          ]
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "createdAt": {
          "type": "string"
        },
        "modelName": {
          "type": [
            "string",
            "null"
          ]
        },
        "promptVersion": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/ClaimDetail/properties/id"
              },
              "chunkId": {
                "$ref": "#/definitions/ClaimDetail/properties/id"
              },
              "sourceId": {
                "$ref": "#/definitions/ClaimDetail/properties/id"
              },
              "sourceTitle": {
                "type": "string"
              },
              "quote": {
                "type": "string"
              },
              "quoteStart": {
                "type": "integer",
                "minimum": 0
              },
              "quoteEnd": {
                "type": "integer",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "chunkId",
              "sourceId",
              "sourceTitle",
              "quote",
              "quoteStart",
              "quoteEnd"
            ],
            "additionalProperties": false
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/ClaimDetail/properties/id"
              },
              "otherClaimId": {
                "$ref": "#/definitions/ClaimDetail/properties/id"
              },
              "otherClaimStatement": {
                "type": "string"
              },
              "relation": {
                "type": "string",
                "enum": [
                  "depends_on",
                  "supersedes",
                  "contradicts",
                  "related_to"
                ]
              },
              "direction": {
                "type": "string",
                "enum": [
                  "outgoing",
                  "incoming"
                ]
              },
              "explanation": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "otherClaimId",
              "otherClaimStatement",
              "relation",
              "direction",
              "explanation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "projectId",
        "kind",
        "statement",
        "workState",
        "evidenceState",
        "reviewState",
        "ownerUserId",
        "ownerLabel",
        "ownerDisplayName",
        "observedAt",
        "evidenceCount",
        "createdAt",
        "modelName",
        "promptVersion",
        "evidence",
        "relationships"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
