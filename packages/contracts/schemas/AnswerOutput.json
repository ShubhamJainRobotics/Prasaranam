{
  "$ref": "#/definitions/AnswerOutput",
  "definitions": {
    "AnswerOutput": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "answered",
            "insufficient_evidence",
            "conflicting_evidence"
          ]
        },
        "statements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "claimIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "required": [
              "text",
              "claimIds"
            ],
            "additionalProperties": false
          },
          "maxItems": 12
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "suggestedClarification": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "statements",
        "limitations",
        "suggestedClarification"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
