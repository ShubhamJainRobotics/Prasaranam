{
  "$ref": "#/definitions/HandoverInput",
  "definitions": {
    "HandoverInput": {
      "type": "object",
      "properties": {
        "project": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        },
        "recipient": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/definitions/HandoverInput/properties/project/properties/id"
            },
            "displayName": {
              "type": "string"
            },
            "role": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "displayName",
            "role"
          ],
          "additionalProperties": false
        },
        "departingMember": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/definitions/HandoverInput/properties/project/properties/id"
            },
            "displayName": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "displayName"
          ],
          "additionalProperties": false
        },
        "configuration": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "recipientId": {
              "$ref": "#/definitions/HandoverInput/properties/project/properties/id"
            },
            "departingUserId": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "not": {}
                    },
                    {
                      "$ref": "#/definitions/HandoverInput/properties/project/properties/id"
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "dateRange": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "not": {}
                    },
                    {
                      "type": "object",
                      "properties": {
                        "from": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "not": {}
                                },
                                {
                                  "type": "string"
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "to": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "not": {}
                                },
                                {
                                  "type": "string"
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "includedSections": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "snapshot",
                  "decisions",
                  "work_in_progress",
                  "owners_contacts",
                  "risks_dependencies",
                  "open_questions",
                  "next_actions"
                ]
              },
              "minItems": 1,
              "maxItems": 7
            },
            "detailLevel": {
              "type": "string",
              "enum": [
                "concise",
                "standard",
                "detailed"
              ]
            },
            "priorityFocus": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "not": {}
                    },
                    {
                      "type": "string",
                      "maxLength": 1000
                    }
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "includeCompletedWork": {
              "type": "boolean"
            },
            "includeProposedNextActions": {
              "type": "boolean"
            },
            "tone": {
              "type": "string",
              "enum": [
                "professional",
                "plain_language"
              ]
            }
          },
          "required": [
            "title",
            "recipientId",
            "includedSections",
            "detailLevel",
            "includeCompletedWork",
            "includeProposedNextActions",
            "tone"
          ],
          "additionalProperties": false
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/HandoverInput/properties/project/properties/id"
              },
              "statement": {
                "type": "string"
              },
              "claimType": {
                "type": "string"
              },
              "evidenceState": {
                "type": "string",
                "enum": [
                  "supported",
                  "corroborated",
                  "needs_confirmation",
                  "conflicting",
                  "unknown"
                ]
              },
              "workState": {
                "type": "string"
              },
              "observedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ownerLabel": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sourceTitles": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "chunkQuotes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "statement",
              "claimType",
              "evidenceState",
              "workState",
              "observedAt",
              "ownerLabel",
              "sourceTitles",
              "chunkQuotes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "project",
        "recipient",
        "configuration",
        "claims"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
